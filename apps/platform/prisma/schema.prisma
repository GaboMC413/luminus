generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  email
  google
  microsoft
  unknown

  @@map("auth_provider")
}

enum AuthIdentityProvider {
  email
  google
  cognito
  microsoft

  @@map("auth_identity_provider")
}

enum UserStatus {
  active
  disabled
  deleted

  @@map("user_status")
}

enum UserRole {
  USER  @map("user")
  ADMIN @map("admin")

  @@map("user_role")
}

enum ConnectionStatus {
  pending
  accepted
  declined
  blocked

  @@map("connection_status")
}

enum UserTier {
  FREE  @map("FREE")
  BASIC @map("BASIC")

  @@map("user_tier")
}

model User {
  id                       String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cognitoSub               String                    @unique @map("cognito_sub")
  email                    String                    @unique @db.VarChar
  passwordHash             String?                   @map("password_hash")
  emailVerified            Boolean                   @default(false) @map("email_verified")
  authProvider             AuthProvider              @default(unknown) @map("auth_provider")
  role                     UserRole                  @default(USER)
  status                   UserStatus                @default(active)
  tier                     UserTier                  @default(FREE)
  trialExpiresAt           DateTime?                 @map("trial_expires_at") @db.Timestamptz
  lastLoginAt              DateTime?                 @map("last_login_at") @db.Timestamptz
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  profile                  UserProfile?
  identities               UserIdentity[]
  interests                UserInterest[]
  profilePrompts           UserProfilePrompt[]
  passwordResetTokens      PasswordResetToken[]
  emailChangeTokens        EmailChangeToken[]
  sentConnections          UserConnection[]          @relation("SentConnections")
  receivedConnections      UserConnection[]          @relation("ReceivedConnections")
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]
  notifications            Notification[]
  reportsSubmitted         UserReport[]              @relation("ReportsSubmitted")
  reportsReceived          UserReport[]              @relation("ReportsReceived")
  activityLogs             ActivityLog[]
  specialistProfile        SpecialistProfile?
  specialistPostulations   SpecialistPostulation[]
  categorySuggestions      CategorySuggestion[]

  @@map("users")
}

model UserIdentity {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String               @map("user_id") @db.Uuid
  provider        AuthIdentityProvider
  providerSubject String               @map("provider_subject") @db.VarChar
  email           String?              @db.VarChar
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@index([email])
  @@map("user_identities")
}

model UserProfile {
  userId       String    @id @map("user_id") @db.Uuid
  fullName     String?   @map("full_name") @db.VarChar
  firstName    String?   @map("first_name") @db.VarChar
  lastName     String?   @map("last_name") @db.VarChar
  avatarUrl    String?   @map("avatar_url") @db.VarChar
  coverUrl     String?   @map("cover_url") @db.VarChar
  profession   String?   @db.VarChar
  city         String?   @db.VarChar
  country      String?   @db.VarChar
  phoneNumber  String?   @map("phone_number") @db.VarChar
  gender       String?   @db.VarChar
  birthdate    DateTime? @db.Timestamptz
  selectedPlan String?   @map("selected_plan") @db.VarChar
  bio          String?   @db.Text
  intention    String?   @db.Text
  isOnboarded  Boolean   @default(false) @map("is_onboarded")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Interest {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId    String           @map("category_id") @db.Uuid
  name          String           @unique @db.VarChar
  slug          String           @unique @db.VarChar
  sortOrder     Int              @default(0) @map("sort_order")
  isActive      Boolean          @default(true) @map("is_active")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  category      InterestCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userInterests UserInterest[]

  @@map("interests")
}

model InterestCategory {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String               @unique @db.VarChar
  slug                String               @unique @db.VarChar
  icon                String?              @db.VarChar
  iconFilled          Boolean              @default(true) @map("icon_filled")
  color               String?              @db.VarChar
  bgColor             String?              @map("bg_color") @db.VarChar
  sortOrder           Int                  @default(0) @map("sort_order")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  interests           Interest[]
  specialistAreas     SpecialistArea[]
  categorySuggestions CategorySuggestion[]
  specialistSpaces    SpecialistSpace[]
  spaceCategories     SpecialistSpaceCategory[]
  spaceServices       SpecialistSpaceService[]

  @@map("interest_categories")
}

model SpecialistArea {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId String           @map("category_id") @db.Uuid
  name       String           @db.VarChar
  slug       String           @unique @db.VarChar
  sortOrder  Int              @default(0) @map("sort_order")
  isActive   Boolean          @default(true) @map("is_active")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  category   InterestCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("specialist_areas")
}

enum SuggestionType {
  USER_INTEREST
  SPECIALIST_AREA

  @@map("suggestion_type")
}

enum SuggestionStatus {
  pending
  approved
  rejected

  @@map("suggestion_status")
}

model CategorySuggestion {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?           @map("user_id") @db.Uuid
  categoryId String?           @map("category_id") @db.Uuid
  type       SuggestionType    @default(USER_INTEREST)
  name       String            @db.VarChar
  status     SuggestionStatus  @default(pending)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  category   InterestCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("category_suggestions")
}

model UserInterest {
  userId     String   @map("user_id") @db.Uuid
  interestId String   @map("interest_id") @db.Uuid
  weight     Int      @default(1) @db.SmallInt
  source     String   @default("onboarding") @db.VarChar
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
  @@map("user_interests")
}

model UserProfilePrompt {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  question  String
  answer    String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_profile_prompts")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.VarChar
  attempts  Int       @default(0) @db.SmallInt
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model EmailChangeToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  email     String    @db.VarChar
  codeHash  String    @map("code_hash") @db.VarChar
  attempts  Int       @default(0) @db.SmallInt
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([email])
  @@map("email_change_tokens")
}

model Notification {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  type           String    @default("system") @db.VarChar
  title          String    @db.VarChar
  actorName      String?   @map("actor_name") @db.VarChar
  actorAvatarUrl String?   @map("actor_avatar_url") @db.VarChar
  body           String
  actionUrl      String?   @map("action_url") @db.VarChar
  readAt         DateTime? @map("read_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model UserConnection {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requesterId String           @map("requester_id") @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  status      ConnectionStatus @default(pending)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  requester   User             @relation("SentConnections", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient   User             @relation("ReceivedConnections", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([requesterId, recipientId])
  @@index([recipientId, status])
  @@index([requesterId, status])
  @@index([requesterId, updatedAt])
  @@index([recipientId, updatedAt])
  @@map("user_connections")
}

model Conversation {
  id           String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  initiatorId  String?                   @map("initiator_id") @db.Uuid
  participants ConversationParticipant[]
  messages     Message[]

  @@index([updatedAt])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String       @map("conversation_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  lastReadAt     DateTime?    @map("last_read_at") @db.Timestamptz
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz
  isMuted        Boolean      @default(false) @map("is_muted")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  body           String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt, deletedAt])
  @@index([senderId])
  @@map("messages")
}

model UserReport {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId  String   @map("reporter_id") @db.Uuid
  reportedId  String   @map("reported_id") @db.Uuid
  reason      String   @db.VarChar
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  reporter User @relation("ReportsSubmitted", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([reportedId])
  @@map("user_reports")
}

model ActivityLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  action    String   @db.VarChar
  details   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

enum PostulationStatus {
  pending
  accepted
  declined

  @@map("postulation_status")
}

model SpecialistPostulation {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  specialty    String            @db.VarChar
  title        String            @db.VarChar
  clinicName   String?           @map("clinic_name") @db.VarChar
  bio          String            @db.Text
  linkedinUrl  String?           @map("linkedin_url") @db.VarChar
  instagramUrl String?           @map("instagram_url") @db.VarChar
  websiteUrl   String?           @map("website_url") @db.VarChar
  courses      Json?
  status       PostulationStatus @default(pending)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  institution   String? @db.VarChar
  selectedAreas Json?   @map("selected_areas")
  clinicData    Json?   @map("clinic_data")
  sessionsData  Json?   @map("sessions_data")
  resumeUrl     String? @map("resume_url") @db.VarChar

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("specialist_postulations")
}

model SpecialistProfile {
  userId       String   @id @map("user_id") @db.Uuid
  specialty    String   @db.VarChar
  title        String   @db.VarChar
  clinicName   String?  @map("clinic_name") @db.VarChar
  bio          String   @db.Text
  linkedinUrl  String?  @map("linkedin_url") @db.VarChar
  instagramUrl String?  @map("instagram_url") @db.VarChar
  websiteUrl   String?  @map("website_url") @db.VarChar
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  institution   String? @db.VarChar
  selectedAreas Json?   @map("selected_areas")
  resumeUrl     String? @map("resume_url") @db.VarChar

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses       SpecialistCourse[]
  spaces        SpecialistSpace[]
  legacyCourses Json?              @map("courses")

  @@map("specialist_profiles")
}

model SpecialistCourse {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String   @db.VarChar
  type        String?  @db.VarChar
  description String   @db.Text
  modality    String?  @db.VarChar
  url         String?  @db.VarChar
  coverUrl    String?  @map("cover_url") @db.VarChar
  institution String?  @db.VarChar
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  specialist SpecialistProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("specialist_courses")
}

model SpecialistSpace {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  spaceType       String?                   @map("space_type") @db.VarChar
  customSpaceType String?                   @map("custom_space_type") @db.VarChar
  categoryArea    String?                   @map("category_area") @db.VarChar
  categoryId      String?                   @map("category_id") @db.Uuid
  name            String                    @db.VarChar
  description     String?                   @db.Text
  address         String?                   @db.VarChar
  city            String?                   @db.VarChar
  country         String?                   @db.VarChar
  lat             Decimal?                  @db.Decimal(9, 6)
  lng             Decimal?                  @db.Decimal(9, 6)
  googlePlaceId   String?                   @map("google_place_id") @db.VarChar
  googleMapsUrl   String?                   @map("google_maps_url") @db.VarChar
  phone           String?                   @db.VarChar
  website         String?                   @db.VarChar
  coverUrl        String?                   @map("cover_url") @db.VarChar
  isActive        Boolean                   @default(true) @map("is_active")
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  specialist      SpecialistProfile         @relation(fields: [userId], references: [userId], onDelete: Cascade)
  category        InterestCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  availability    SpecialistAvailability[]
  spaceCategories SpecialistSpaceCategory[]
  services        SpecialistSpaceService[]

  @@index([userId])
  @@index([categoryId])
  @@index([city])
  @@map("specialist_spaces")
}

model SpecialistSpaceCategory {
  spaceId    String           @map("space_id") @db.Uuid
  categoryId String           @map("category_id") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz

  space    SpecialistSpace  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  category InterestCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([spaceId, categoryId])
  @@index([categoryId])
  @@map("specialist_space_categories")
}

model SpecialistSpaceService {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spaceId    String           @map("space_id") @db.Uuid
  categoryId String           @map("category_id") @db.Uuid
  name       String           @db.VarChar
  isCustom   Boolean          @default(false) @map("is_custom")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz

  space    SpecialistSpace  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  category InterestCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([spaceId])
  @@index([categoryId])
  @@map("specialist_space_services")
}

model SpecialistAvailability {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spaceId   String   @map("space_id") @db.Uuid
  dayOfWeek Int      @map("day_of_week") @db.SmallInt
  startTime String   @map("start_time") @db.VarChar
  endTime   String   @map("end_time") @db.VarChar
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  space SpecialistSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId])
  @@map("specialist_availability")
}

model SentEmailLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipient String   @db.VarChar
  subject   String   @db.VarChar
  htmlBody  String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([recipient])
  @@index([createdAt])
  @@map("sent_email_logs")
}

model Event {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  youtubeId   String?            @unique @map("youtube_id") @db.VarChar
  slug        String?            @unique @db.VarChar
  title       String             @db.VarChar
  description String             @db.Text
  date        DateTime?          @db.Timestamptz
  timeText    String?            @map("time_text") @db.VarChar
  location    String?            @db.VarChar
  speakerName String?            @map("speaker_name") @db.VarChar
  speakerBio  String?            @map("speaker_bio") @db.Text
  category    String?            @db.VarChar
  coverUrl    String?            @map("cover_url") @db.VarChar
  link        String?            @db.VarChar
  isUpcoming  Boolean            @default(true) @map("is_upcoming")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  inscriptions EventInscription[]

  @@map("events")
}

model EventGuest {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String             @unique @db.VarChar
  firstName        String             @map("first_name") @db.VarChar
  lastName         String?            @map("last_name") @db.VarChar
  city             String?            @db.VarChar
  marketingConsent Boolean            @default(true) @map("marketing_consent")
  isGuest          Boolean            @default(true) @map("is_guest")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  inscriptions     EventInscription[]

  @@map("event_guests")
}

model EventInscription {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String     @map("event_id") @db.Uuid
  guestId   String     @map("guest_id") @db.Uuid
  attended  Boolean    @default(false)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest     EventGuest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([eventId, guestId])
  @@index([eventId])
  @@index([guestId])
  @@map("event_inscriptions")
}

model ContactMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre    String   @db.VarChar
  apellido  String   @db.VarChar
  email     String   @db.VarChar
  telefono  String?  @db.VarChar
  pais      String?  @db.VarChar
  motivo    String   @db.VarChar
  mensaje   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([email])
  @@index([createdAt])
  @@map("contact_messages")
}

