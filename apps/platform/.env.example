
AUTH_BASE_URL="http://localhost:3100"
S3_AVATAR_BUCKET="luminus-dev-avatars"
S3_AVATAR_REGION="us-east-1"
S3_AVATAR_PUBLIC_BASE_URL="https://luminus-dev-avatars.s3.us-east-1.amazonaws.com"
S3_AVATAR_ACCESS_KEY_ID="change-me"
S3_AVATAR_SECRET_ACCESS_KEY="change-me"
SES_REGION="us-east-1"
SES_FROM_EMAIL="info@luminuslatam.com"
SES_ACCESS_KEY_ID="change-me"
SES_SECRET_ACCESS_KEY="change-me"
COGNITO_DOMAIN="change-me.auth.us-east-1.amazoncognito.com"
COGNITO_REGION="us-east-1"
COGNITO_CLIENT_ID="change-me"
COGNITO_CLIENT_SECRET="change-me"
COGNITO_USER_POOL_ID="us-east-1_change-me"
COGNITO_ADMIN_ACCESS_KEY_ID="change-me"
COGNITO_ADMIN_SECRET_ACCESS_KEY="change-me"

# Local development bypass flags
NEXT_PUBLIC_USE_MOCK_AVATAR_UPLOAD=true
# Set to true to fall back to local mock data (MOCK_USERS and mock profiles) if the dev database/auth is not available.
# Set to false (or remove) to require real database connections and raise errors when offline.
NEXT_PUBLIC_USE_MOCK_DATA=false

